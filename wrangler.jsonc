{
  "name": "zaal-cafe-website",
  "compatibility_date": "2026-09-11",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zaal-cafe-prod",
      "database_id": "3937f93a-5583-4773-b1ae-6398c712d504"
    }
  ],
  "workers_dev": false,
  "keep_vars": true
}
